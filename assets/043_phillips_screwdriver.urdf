      <!-- Inertia tensor for a Phillips screwdriver: -->
      <!-- Estimated dimensions: length ~16cm, diameter ~2cm -->
      <!-- Using rod-like inertia with length along Z-axis -->
      <inertia 
        ixx="0.0005" ixy="0.0" ixz="0.0" 
        iyy="0.0005" iyz="0.0" 
        izz="0.00001"/>
    </inertial>
